# Enable local CMS Admin Panel (http://localhost:3000/admin)
# Set to 'true' in development. Automatically disabled in production.
ENABLE_ADMIN_PANEL=true

# Your production domain URL
# Used for absolute URLs in sitemap.xml, robots.txt, and social meta tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel Basic Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_super_secret_password_here
