{
  "name": "my-portfolio",
  "version": "0.1.0",
  "description": "Minimalist Developer Portfolio & Local CMS template built with Next.js",
  "author": "Berke Güvenç",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berkeguvenc/my-portfolio.git"
  },
  "scripts": {
    "setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/data/portfolio.json')) fs.copyFileSync('src/data/portfolio.example.json', 'src/data/portfolio.json')\"",
    "predev": "npm run setup",
    "prebuild": "npm run setup",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
